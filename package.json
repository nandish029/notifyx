{
  "name": "@nandish029/notifyx",
  "version": "2.0.0",
  "description": "A lightweight, production-ready browser push notification framework with offline analytics",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./sw": {
      "import": "./dist/sw.js",
      "require": "./dist/sw.cjs",
      "types": "./dist/sw.d.ts"
    }
  },
  "type": "module",
  "bin": {
    "notifyx": "cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "playwright test"
  },
  "files": [
    "dist/",
    "cli/",
    "integrations/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "push-notifications",
    "service-worker",
    "web-push",
    "vibecoding"
  ],
  "author": "Nandish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandish029/notifyx.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "fs-extra": "^11.3.5",
    "prompts": "^2.4.2",
    "web-push": "^3.6.7"
  }
}
